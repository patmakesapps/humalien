# Connection
OPENAI_API_KEY=your_open_ai_api_key_here
HUMALIEN_PI_URL=ws://10.0.0.83:8765

# Conversation
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=marin
# HUMALIEN_MIC_GATE: half_duplex (no echo cancellation, no barge-in)
#                    open        (requires an echo-cancelled mic source)
HUMALIEN_MIC_GATE=half_duplex
HUMALIEN_VAD_EAGERNESS=auto
HUMALIEN_NOISE_REDUCTION=far_field
HUMALIEN_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Character and delivery. Edit brain/persona.md, or point at another file
# to swap the whole vibe without touching code.
# HUMALIEN_PERSONA=persona.md

# Eyes and memory
HUMALIEN_CAMERA=0
# HUMALIEN_VISION: realtime (fast, the model sees the frame itself, costs
#                            image tokens on the expensive model)
#                  ollama   (slow, free, works offline)
# Realtime falls back to ollama on its own if the session refuses an image.
HUMALIEN_VISION=realtime
HUMALIEN_VISION_MODEL=gemma4:cloud
# HUMALIEN_DB=humalien.db

# Debug window showing what the camera sees. Off for the robot.
HUMALIEN_SHOW_VIDEO=0

# Whether seeing somebody is enough for Humalien to speak first.
# 0 means it only ever answers, never opens.
HUMALIEN_GREET_ON_SIGHT=1

# Desktop node simulator, for testing on a laptop instead of the Pi.
# Find the indices with: python tools/list_audio_devices.py
# Point HUMALIEN_PI_URL at ws://127.0.0.1:8765 while using this.
HUMALIEN_DESKTOP_INPUT_DEVICE=
HUMALIEN_DESKTOP_OUTPUT_DEVICE=
