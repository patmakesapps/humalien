# Python
**/.venv/
**/__pycache__/
*.pyc

# Environment / secrets
.env
.env.*
!.env.example

# Audio test artifacts
*.wav

# ONNX models — run brain/tools/fetch_models.py instead
brain/models/

# Who Humalien has met. Local to each machine, never committed.
*.db
*.db-wal
*.db-shm

# Somebody else's 3D models, kept locally as a measuring reference.
# Not ours to redistribute — see reference/eye-mechanism/README.md
reference/**/*.3mf
reference/**/*.stl
reference/**/*.step
reference/**/*.obj
reference/**/*.mtl
reference/**/*.fbx
reference/**/*.blend

# The head mesh is royalty-free under a No AI licence: free to use in the
# build, not free to redistribute, and never to be fed to a generative 3D
# tool. It stays out of git entirely — cad/head_ref.py reproduces the
# import and scaling from wherever you keep the file locally.
**/female_human_head.*

# Blender working files, including the .blend1/.blend2 rolling backups and any
# hand-made safety copy. Same rule as print/ and for the same first reason:
# HEAD_FACE and HEAD_CRANIUM live inside these and are cut from the
# No-AI-licence head sculpt above, so the file is not ours to redistribute.
# It is also 50 MB of binary that git cannot diff, and cad/*.py rebuilds it.
# What is NOT reproducible - the USERFIX_HEAD_CRANIUM hand edit - is a
# liability precisely because it only exists here. See commit 30235e1.
*.blend
*.blend[0-9]

# Editors / OS
.vscode/
.DS_Store
Thumbs.db
# Sliceable STLs, regenerated by cad/print_layout.py in about a minute.
# Build output, and more importantly HEAD_FACE and HEAD_CRANIUM are cut from
# the No-AI-licence head sculpt above - free to use in this build, not free
# to redistribute. Same rule as the source mesh: it stays out of git.
print/

# exports/ is one folder per print plate and IS tracked - those parts are all
# our own geometry and it is useful to have the exact file that was printed.
# Plates 1 and 2 are the exception and are not negotiable: they are
# HEAD_CRANIUM and HEAD_FACE, cut straight from the No-AI-licence head
# sculpt. Exporting them is fine, committing them is redistribution.
exports/plate1/
exports/plate2/
